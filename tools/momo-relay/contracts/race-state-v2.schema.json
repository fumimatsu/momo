{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/fumimatsu/momo-race-control/contracts/race-state-v2.schema.json",
  "title": "Momo Race State v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "version", "raceId", "phase", "flag", "serverTimeMs", "standings", "lapHistory"],
  "properties": {
    "type": { "const": "race_state" },
    "version": { "const": 2 },
    "raceId": { "type": "string", "minLength": 1 },
    "raceRunId": { "type": "string", "minLength": 1 },
    "sequence": { "type": "integer", "minimum": 0 },
    "phase": { "enum": ["idle", "ready", "countdown", "green", "finished", "paused"] },
    "flag": { "enum": ["none", "green", "yellow", "red", "finish"] },
    "serverTimeMs": { "type": "integer", "minimum": 0 },
    "startAtMs": { "type": "integer", "minimum": 0 },
    "countdown": { "type": "number", "minimum": 0 },
    "startSignalMode": { "enum": ["green", "lights_out"] },
    "message": { "type": "string" },
    "allTimeMode": { "enum": ["elapsed", "countdown"] },
    "viewerCarId": { "type": "string" },
    "raceInfo": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "title": { "type": "string" },
        "totalLaps": { "type": "integer", "minimum": 1 },
        "track": { "type": "string" },
        "note": { "type": "string" },
        "viewerBaseUrl": { "type": "string" },
        "sessionType": { "enum": ["practice", "qualify", "race"] }
      }
    },
    "roster": { "$ref": "#/$defs/activeRoster" },
    "self": { "$ref": "#/$defs/standing" },
    "standings": { "type": "array", "maxItems": 64, "items": { "$ref": "#/$defs/standing" } },
    "lapHistory": { "type": "array", "maxItems": 64, "items": { "$ref": "#/$defs/lapHistory" } }
  },
  "$defs": {
    "rosterParticipant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceId", "carId", "pilotId", "pilotName", "driveSessionId"],
      "properties": {
        "vehicleId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "sourceId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "carId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" },
        "carName": { "type": "string", "minLength": 1, "maxLength": 128 },
        "displayNumber": { "type": "string", "minLength": 1, "maxLength": 32 },
        "pilotId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "pilotNo": { "type": "string", "minLength": 1, "maxLength": 32 },
        "pilotName": { "type": "string", "minLength": 1, "maxLength": 128 },
        "teamName": { "type": "string", "minLength": 1, "maxLength": 128 },
        "photoUrl": { "type": "string", "minLength": 9, "maxLength": 2048, "pattern": "^https://" },
        "comment": { "type": "string", "minLength": 1, "maxLength": 160 },
        "color": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
        "driveSessionId": { "type": "string", "minLength": 1, "maxLength": 256 }
      }
    },
    "activeRoster": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "revision", "participants", "updatedAtUnixMs", "locked", "raceRunId"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "revision": { "type": "integer", "minimum": 1 },
        "directoryRevision": { "type": "string", "minLength": 1, "maxLength": 35 },
        "participants": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": { "$ref": "#/$defs/rosterParticipant" }
        },
        "updatedAtUnixMs": { "type": "integer", "minimum": 0 },
        "locked": { "const": true },
        "raceRunId": { "type": "string", "minLength": 1 }
      }
    },
    "sectorTime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sector"],
      "properties": {
        "sector": { "type": "integer", "minimum": 1, "maximum": 6 },
        "lastMs": { "type": "integer", "minimum": 1 },
        "bestMs": { "type": "integer", "minimum": 1 }
      },
      "anyOf": [{ "required": ["lastMs"] }, { "required": ["bestMs"] }]
    },
    "standing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["carId", "position", "status", "lap"],
      "properties": {
        "carId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" },
        "roomId": { "type": "string" },
        "driver": { "type": "string" },
        "directionStatus": { "enum": ["normal", "wrong_way", "unknown"] },
        "position": { "type": "integer", "minimum": 1, "maximum": 64 },
        "status": { "type": "string", "minLength": 1, "maxLength": 64 },
        "lap": { "type": "integer", "minimum": 0 },
        "lapTimeMs": { "type": "integer", "minimum": 0 },
        "bestLapMs": { "type": "integer", "minimum": 0 },
        "allTimeMs": { "type": "integer", "minimum": 0 },
        "currentLapMs": { "type": "integer", "minimum": 0 },
        "intervalToAheadMs": {
          "type": "integer",
          "minimum": 0,
          "description": "Time from the predecessor to this car at this car's latest comparable checkpoint, including across a completed-lap counter boundary."
        },
        "lapDeltaToAhead": {
          "type": "integer",
          "minimum": 1,
          "description": "Confirmed full-lap difference at this car's latest checkpoint, not the raw completed-lap counter difference."
        },
        "lappingCarBehindId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" },
        "lappingGapMs": { "type": "integer", "minimum": 1 },
        "currentSector": { "type": "integer", "minimum": 1, "maximum": 6 },
        "sectorCount": { "type": "integer", "minimum": 1, "maximum": 6 },
        "lastMarkerIndex": { "type": "integer", "minimum": 0, "maximum": 5 },
        "lastMarkerRaceMs": { "type": "integer", "minimum": 0 },
        "sectorTimes": { "type": "array", "maxItems": 6, "items": { "$ref": "#/$defs/sectorTime" } }
      },
      "allOf": [
        { "if": { "required": ["lappingCarBehindId"] }, "then": { "required": ["lappingGapMs"] } },
        { "if": { "required": ["lappingGapMs"] }, "then": { "required": ["lappingCarBehindId"] } }
      ]
    },
    "lapSectorTime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sector", "timeMs"],
      "properties": {
        "sector": { "type": "integer", "minimum": 1, "maximum": 6 },
        "timeMs": { "type": "integer", "minimum": 1 }
      }
    },
    "lapHistory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["carId", "lap", "completedAtRaceMs", "lapTimeMs", "sectorTimes"],
      "properties": {
        "carId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" },
        "lap": { "type": "integer", "minimum": 1 },
        "completedAtRaceMs": { "type": "integer", "minimum": 0 },
        "lapTimeMs": { "type": "integer", "minimum": 1 },
        "achievement": { "enum": ["personal_best", "overall_best"] },
        "sectorTimes": { "type": "array", "maxItems": 6, "items": { "$ref": "#/$defs/lapSectorTime" } }
      }
    }
  }
}
