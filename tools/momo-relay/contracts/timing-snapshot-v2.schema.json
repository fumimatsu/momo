{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/fumimatsu/momo-race-control/contracts/timing-snapshot-v2.schema.json",
  "title": "Momo Timing Snapshot v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "raceRunId", "sequence", "allTimeMode", "standings", "lapHistory"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "raceRunId": { "type": "string", "minLength": 1 },
    "sequence": { "type": "integer", "minimum": 1 },
    "allTimeMode": { "enum": ["elapsed", "countdown"] },
    "standings": { "type": "array", "maxItems": 4, "items": { "$ref": "#/$defs/standing" } },
    "lapHistory": { "type": "array", "maxItems": 64, "items": { "$ref": "#/$defs/lapHistory" } }
  },
  "$defs": {
    "sectorTime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sector"],
      "properties": {
        "sector": { "type": "integer", "minimum": 1, "maximum": 6 },
        "lastMs": { "type": "integer", "minimum": 1 },
        "bestMs": { "type": "integer", "minimum": 1 }
      },
      "anyOf": [{ "required": ["lastMs"] }, { "required": ["bestMs"] }]
    },
    "standing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["carId", "position", "status", "lap"],
      "properties": {
        "carId": { "enum": ["CP-1", "CP-2", "CP-3", "CP-4"] },
        "driver": { "type": "string" },
        "directionStatus": { "enum": ["normal", "wrong_way", "unknown"] },
        "position": { "type": "integer", "minimum": 1, "maximum": 4 },
        "status": { "enum": ["racing", "finished", "retired"] },
        "lap": { "type": "integer", "minimum": 0 },
        "lapTimeMs": { "type": "integer", "minimum": 0 },
        "bestLapMs": { "type": "integer", "minimum": 0 },
        "allTimeMs": { "type": "integer", "minimum": 0 },
        "currentLapMs": { "type": "integer", "minimum": 0 },
        "intervalToAheadMs": { "type": "integer", "minimum": 0 },
        "lapDeltaToAhead": { "type": "integer", "minimum": 1 },
        "lappingCarBehindId": { "enum": ["CP-1", "CP-2", "CP-3", "CP-4"] },
        "lappingGapMs": { "type": "integer", "minimum": 1 },
        "currentSector": { "type": "integer", "minimum": 1, "maximum": 6 },
        "sectorCount": { "type": "integer", "minimum": 1, "maximum": 6 },
        "lastMarkerIndex": { "type": "integer", "minimum": 0, "maximum": 5 },
        "lastMarkerRaceMs": { "type": "integer", "minimum": 0 },
        "sectorTimes": { "type": "array", "maxItems": 6, "items": { "$ref": "#/$defs/sectorTime" } }
      },
      "allOf": [
        { "if": { "anyOf": [{ "required": ["currentSector"] }, { "required": ["lastMarkerIndex"] }, { "required": ["lastMarkerRaceMs"] }, { "required": ["sectorTimes"] }] }, "then": { "required": ["sectorCount"] } },
        { "if": { "required": ["lastMarkerIndex"] }, "then": { "required": ["lastMarkerRaceMs"] } },
        { "if": { "required": ["lastMarkerRaceMs"] }, "then": { "required": ["lastMarkerIndex"] } },
        { "if": { "required": ["lappingCarBehindId"] }, "then": { "required": ["lappingGapMs"] } },
        { "if": { "required": ["lappingGapMs"] }, "then": { "required": ["lappingCarBehindId"] } },
        { "not": { "required": ["intervalToAheadMs", "lapDeltaToAhead"] } }
      ]
    },
    "lapSectorTime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sector", "timeMs"],
      "properties": {
        "sector": { "type": "integer", "minimum": 1, "maximum": 6 },
        "timeMs": { "type": "integer", "minimum": 1 }
      }
    },
    "lapHistory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["carId", "lap", "completedAtRaceMs", "lapTimeMs", "sectorTimes"],
      "properties": {
        "carId": { "enum": ["CP-1", "CP-2", "CP-3", "CP-4"] },
        "lap": { "type": "integer", "minimum": 1 },
        "completedAtRaceMs": { "type": "integer", "minimum": 0 },
        "lapTimeMs": { "type": "integer", "minimum": 1 },
        "achievement": { "enum": ["personal_best", "overall_best"] },
        "sectorTimes": { "type": "array", "maxItems": 6, "items": { "$ref": "#/$defs/lapSectorTime" } }
      }
    }
  }
}
